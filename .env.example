# Copy to .env and adjust. Never commit .env.

# --- Database (Phase 0) ---
POSTGRES_DB=caa_legal
POSTGRES_USER=caa
POSTGRES_PASSWORD=caa_dev_password
POSTGRES_PORT=5460
DATABASE_URL=postgresql://caa:caa_dev_password@localhost:5460/caa_legal

# --- App ---
APP_URL=http://localhost:3000

# --- Seed: first Admin account (temporary password must be changed at first login, Phase 1) ---
SEED_ADMIN_EMAIL=head.legal@caa.go.ug
SEED_ADMIN_NAME=Head of Legal
# Local/demo password assigned to the seeded Admin and sample lawyers.
# SEED_PASSWORD=pass123
# DEMO_LOGIN_PASSWORD=pass123

# --- Object storage (Phase 6) ---
# S3-compatible storage (MinIO/SeaweedFS) is the intended production target; local dev uses
# encrypted filesystem storage via DOCUMENT_STORAGE_DIR until that's wired up (src/lib/storage.ts).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=caa-legal-documents
S3_ACCESS_KEY=caa_minio
S3_SECRET_KEY=caa_minio_dev_password
DOCUMENT_STORAGE_DIR=./storage/documents

# --- Virus scan (Phase 6) ---
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
# Spec requires every upload scanned before use (§9). Keep this true — set false only for local
# testing when no clamd is reachable (`docker compose --profile scan up -d`).
REQUIRE_VIRUS_SCAN=true

# --- Email (Phase 1+). Dev uses Mailpit: http://localhost:8026 (port picked to avoid clashing with another local project) ---
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="CAA Legal <no-reply@caa.go.ug>"

# --- Auth (Phase 1) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=replace-with-a-generated-32-byte-secret
# Optional: give the seeded Admin a fixed temp password instead of a random one
# SEED_ADMIN_PASSWORD=
# Spec requires 2FA on every account (§5.1). Keep this true — set false only for local testing.
REQUIRE_2FA=true
# Shared lawyer password for local/prototype demos. Leave empty in production.
# DEMO_LOGIN_PASSWORD=

# --- Documents (Phase 6) ---
# Envelope encryption master key — wraps each file's own per-file data key. Keep outside the
# database and out of version control.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DOCUMENT_MASTER_KEY=replace-with-a-generated-32-byte-base64-key

# --- Video calls (case Discussion) ---
# LiveKit Cloud project — Settings page for the URL, API Keys page for the key/secret pair.
# Leave all three unset to simply hide the "Start video call" button.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Background jobs (reminders, 7:00 AM digest, unread-chat emails) ---
# Run inside the app server via pg-boss (its own `pgboss` schema in the same database).
# Leave on; with several app instances each tick still runs once. false = this process runs no jobs.
JOBS_ENABLED=true
