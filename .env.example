# Copy to .env and adjust. Never commit .env.

# --- Database (Phase 0) ---
POSTGRES_DB=caa_legal
POSTGRES_USER=caa
POSTGRES_PASSWORD=caa_dev_password
POSTGRES_PORT=5460
DATABASE_URL=postgresql://caa:caa_dev_password@localhost:5460/caa_legal

# --- App ---
APP_URL=http://localhost:3000

# --- Seed: first Admin account (temporary password must be changed at first login, Phase 1) ---
SEED_ADMIN_EMAIL=head.legal@caa.go.ug
SEED_ADMIN_NAME=Head of Legal

# --- Object storage, S3-compatible (Phase 6) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=caa-legal-documents
S3_ACCESS_KEY=caa_minio
S3_SECRET_KEY=caa_minio_dev_password

# --- Virus scan (Phase 6) ---
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --- Email (Phase 1+). Dev uses Mailpit: http://localhost:8025 ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="CAA Legal <no-reply@caa.go.ug>"

# --- Added in later phases ---
# AUTH_SECRET=            (Phase 1)
# DOCUMENT_MASTER_KEY=    (Phase 6 — envelope encryption master key; keep outside the database)
