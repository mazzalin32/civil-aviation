// CAA Legal — data model. Grows phase by phase (PROJECT_SPEC.md §7, §12).
// Phase 0: users (profile + security fields), settings, audit log.
// Phase 1: Better Auth's own tables (Session, Account, Verification, TwoFactor) — field
// names/shapes must match what its Prisma adapter expects; see src/lib/auth.ts.
// Phase 2: Admin-configured reference data (spec §5.13) — categories, matter types &
// lifecycle templates, forums, event/document types, outcomes, reminder rules. Nothing
// legal is hard-coded (CLAUDE.md); every later feature reads these instead.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPERADMIN // platform-level: manages Organizations and their Admins, belongs to none itself
  ADMIN
  LAWYER
}

/// A tenant on the platform (2026-10-25 — multi-tenancy foundation; CAA is the only real
/// Organization today, but every Admin/Lawyer, Matter and Contract is scoped to one so the
/// platform can onboard further organisations later without another retrofit). White-labelling
/// is deliberately minimal: logo, display name, one accent colour — nothing else varies per org.
model Organization {
  id           String   @id @default(cuid())
  name         String   @unique
  logoUrl      String?
  primaryColor String? // hex, overrides the --primary design token for this org's signed-in users
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users          User[]
  matters        Matter[]
  groupMessages  GroupMessage[]
  groupChatReads GroupChatRead[]
  contracts      Contract[]
}

model User {
  id                 String        @id @default(cuid())
  organizationId     String? // null only for SUPERADMIN — every Admin/Lawyer belongs to exactly one
  organization       Organization? @relation(fields: [organizationId], references: [id])
  name               String
  email              String        @unique
  emailVerified      Boolean       @default(false)
  image              String?
  phone              String?
  role               Role          @default(LAWYER)
  title              String?
  department         String?
  practisingCertNo   String?
  certExpiry         DateTime?     @db.Date
  isActive           Boolean       @default(true)
  deletedAt          DateTime? // soft delete: hidden from lists, cannot sign in; never a hard delete
  // Security state we own (not Better Auth's concern): 2FA display, forced change,
  // lockout. The password hash and TOTP secret live in Account / TwoFactor below.
  twoFactorEnabled   Boolean       @default(false) // field name/shape required by the twoFactor plugin
  mfaEnabledAt       DateTime? // when 2FA setup was completed — for admin visibility only
  mustChangePassword Boolean       @default(false)
  passwordChangedAt  DateTime?
  failedLoginCount   Int           @default(0)
  lockedUntil        DateTime?
  // Preferences
  digestEnabled      Boolean       @default(false)
  theme              String        @default("system") // system | light | dark
  icsToken           String?       @unique // long-lived token for the .ics calendar subscription URL
  lastLoginAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  // Set when this account was created by a bulk import; lets a batch be rolled back.
  importBatchId String?
  importBatch   ImportBatch? @relation("BatchMembers", fields: [importBatchId], references: [id])

  auditLogs               AuditLog[]
  settingsUpdated         Setting[]
  sessions                Session[]
  accounts                Account[]
  twoFactor               TwoFactor[]
  importBatchesCreated    ImportBatch[] @relation("BatchCreatedBy")
  importBatchesRolledBack ImportBatch[] @relation("BatchRolledBackBy")

  mattersCreated      Matter[]            @relation("MatterCreatedBy")
  mattersClosed       Matter[]            @relation("MatterClosedBy")
  mattersReceived     Matter[]            @relation("MatterLegalRecipient")
  matterAssignments   MatterAssignment[]  @relation("MatterAssignee")
  matterAssignmentsBy MatterAssignment[]  @relation("MatterAssignedBy")
  matterStagesMoved   MatterStage[]
  wizardDraft         WizardDraft?
  eventsCreated       Event[]
  summaryVersions     SummaryVersion[]
  notes               Note[]
  documentsUploaded   Document[]
  documentVersions    DocumentVersion[]
  documentAccessLogs  DocumentAccessLog[]

  personalCalendarEntries CalendarEntry[]          @relation("PersonalCalendarEntries")
  assignedCalendarEntries CalendarEntry[]          @relation("AssignedCalendarEntries")
  outcomesRecorded        CalendarEntry[]          @relation("OutcomeRecordedEntries")
  tasksAssigned           Task[]                   @relation("TasksAssigned")
  tasksCreated            Task[]                   @relation("TasksCreated")
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  matterMessages          MatterMessage[]          @relation("MatterMessages")
  pinnedMatterMessages    MatterMessage[]          @relation("MessagePinnedBy")
  deletedMatterMessages   MatterMessage[]          @relation("MessageDeletedBy")
  matterMessageMentions   MatterMessageMention[]
  matterChatReads         MatterChatRead[]
  groupMessages           GroupMessage[]           @relation("GroupMessageAuthor")
  groupMessagesDeleted    GroupMessage[]           @relation("GroupMessageDeletedBy")
  groupChatReads          GroupChatRead[]
  lawFirmsAdded           LawFirm[]
  resourceLinksAdded      ResourceLink[]

  contractsCreated           Contract[]                  @relation("ContractCreatedBy")
  contractAssignments        ContractAssignment[]        @relation("ContractAssignee")
  contractAssignmentsBy      ContractAssignment[]        @relation("ContractAssignedBy")
  contractDocumentsUploaded  ContractDocument[]
  contractDocumentVersions   ContractDocumentVersion[]
  contractDocumentAccessLogs ContractDocumentAccessLog[]

  @@index([organizationId])
  @@index([role, isActive])
  @@index([importBatchId])
}

/// One bulk-import run (spec §5.12). "details" holds the per-row outcome and error
/// report — no file storage needed for this since Phase 6 doesn't exist yet, and this
/// is small enough (a department's lawyer roster) to keep inline.
model ImportBatch {
  id             String    @id @default(cuid())
  kind           String // "USERS" for now; matters get their own kind in Phase 12
  rowsTotal      Int
  rowsOk         Int
  rowsFailed     Int
  details        Json // { errors: [{ row, reasons }], columns: {...} }
  createdById    String
  createdBy      User      @relation("BatchCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime  @default(now())
  rolledBackAt   DateTime?
  rolledBackById String?
  rolledBackBy   User?     @relation("BatchRolledBackBy", fields: [rolledBackById], references: [id])

  members User[] @relation("BatchMembers")

  @@index([kind, createdAt])
}

// --- Better Auth (email+password, sessions, 2FA). Field shapes are fixed by the
// library's Prisma adapter — see node_modules/@better-auth/core/dist/db/schema/*.
// One session row per signed-in device; deleting all of a user's rows is "sign out everywhere".
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Holds the hashed password (providerId "credential"). No social providers in v1.
model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId            String
  accountId             String
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

/// Single-use tokens: invite links and "forgot password" both use this (spec §15 decision).
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/// TOTP secret + backup codes, added by the twoFactor plugin.
model TwoFactor {
  id                      String    @id @default(cuid())
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret                  String
  backupCodes             String
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  @@index([userId])
}

/// Key/value system settings edited in the Admin Settings portal (security, branding, AI switch…).
model Setting {
  key         String   @id
  value       Json
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
}

enum ClosurePolicy {
  ADMIN_APPROVAL
  LAWYER_CLOSES
}

/// Subject — what a matter is about (spec §7 "Category vs matter type"). Drives reports.
model Category {
  id       String     @id @default(cuid())
  name     String
  parentId String?
  parent   Category?  @relation("CategoryToParent", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToParent")
  color    String // one of the design-token status colours, stored by name (e.g. "primary")
  order    Int        @default(0)
  isActive Boolean    @default(true)

  matters   Matter[]
  contracts Contract[]

  @@unique([name])
  @@index([parentId])
}

/// Process — how a matter runs; picks its lifecycle (spec §7). isSubProcess marks
/// templates used for applications/appeals/execution/costs inside a matter, not on their own.
model MatterType {
  id              String        @id @default(cuid())
  name            String
  referencePrefix String? // e.g. "LIT" → UCAA/LIT/2026/0042 (spec §5.13); null for sub-process types
  closurePolicy   ClosurePolicy @default(ADMIN_APPROVAL)
  isSubProcess    Boolean       @default(false)
  order           Int           @default(0)
  isActive        Boolean       @default(true)

  stages  StageTemplate[]
  matters Matter[]

  @@unique([name])
  @@index([isSubProcess, isActive])
}

/// One step in a matter type's lifecycle. requiredFields is a small set of field keys the
/// stage-move form must collect (e.g. "filingDate") — the real form fields arrive in Phase 5.
model StageTemplate {
  id             String     @id @default(cuid())
  matterTypeId   String
  matterType     MatterType @relation(fields: [matterTypeId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  order          Int
  allowsClosure  Boolean    @default(false)
  requiredFields String[]
  isActive       Boolean    @default(true)

  mattersCurrent Matter[]
  stageMoves     MatterStage[]

  @@unique([matterTypeId, name])
  @@index([matterTypeId, order])
}

/// Court / tribunal / forum (Uganda hierarchy, spec §3, plus arbitration and internal panels).
model Forum {
  id       String  @id @default(cuid())
  name     String
  level    String // e.g. "HIGH_COURT", "TRIBUNAL", "ARBITRATION", "INTERNAL_PANEL" — a label, not an enum, so Admin can add new kinds
  division String?
  location String?
  order    Int     @default(0)
  isActive Boolean @default(true)

  matters         Matter[]
  calendarEntries CalendarEntry[]

  @@unique([name])
}

/// Timeline event kind (filing, hearing, ruling, correspondence, …).
model EventType {
  id       String  @id @default(cuid())
  name     String  @unique
  icon     String? // lucide-react icon name
  order    Int     @default(0)
  isActive Boolean @default(true)

  events        Event[]
  deadlineRules DeadlineRule[]
}

/// Document tab folder (Pleadings, Evidence, Correspondence, Court Orders, Submissions, Internal Memos).
model DocumentFolder {
  id       String  @id @default(cuid())
  name     String  @unique
  order    Int     @default(0)
  isActive Boolean @default(true)

  documents         Document[]
  contractDocuments ContractDocument[]
}

/// Matter outcome (Won, Lost, Settled, …).
model Outcome {
  id       String  @id @default(cuid())
  name     String  @unique
  order    Int     @default(0)
  isActive Boolean @default(true)

  matters Matter[]
}

/// Reminder schedule for one trigger (a hearing coming up, a deadline, an assignment, …).
/// Sending the actual reminder is Phase 8; this phase only edits the schedule.
model NotificationRule {
  id       String   @id @default(cuid())
  trigger  String   @unique // e.g. "HEARING_REMINDER", "DEADLINE_REMINDER" — matches spec §5.9
  label    String // shown in the settings UI, e.g. "Hearing coming up"
  offsets  Int[] // days before (positive) / after (negative) the trigger date; 0 = same day
  channels String[] // "IN_APP" | "EMAIL"
  mutable  Boolean  @default(true) // false = lawyer can't turn this one off (spec §5.9)

  preferences NotificationPreference[]
}

/// One in-app (+ optionally emailed) notification (spec §5.9, FLOWS §12).
model Notification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String // matches NotificationRule.trigger
  matterId   String?
  matter     Matter?   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: Cascade)
  payload    Json
  message    String // the same human-readable line notify() sends by email — the in-app bell shows this directly
  url        String? // where "open" takes you; null for notifications with nowhere to go
  readAt     DateTime?
  emailedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/// Per-user mute for a mutable NotificationRule (spec §5.9) — absence of a row means "on"
/// for both channels, so muting is opt-in and a new rule defaults to enabled for everyone.
model NotificationPreference {
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   String
  rule   NotificationRule @relation(fields: [type], references: [trigger], onDelete: Cascade)
  inApp  Boolean          @default(true)
  email  Boolean          @default(true)

  @@id([userId, type])
}

/// Tracks the next case number per prefix+year (used from Phase 4 to generate references).
model ReferenceCounter {
  prefix String
  year   Int
  next   Int    @default(1)

  @@id([prefix, year])
}

enum UcaaRole {
  PLAINTIFF
  DEFENDANT
  APPLICANT
  RESPONDENT
  ADVISOR
  CLAIMANT
  PETITIONER
  INTERESTED_PARTY
  APPELLANT
  RESPONDENT_TO_APPEAL
  OTHER
}

enum ServiceDirection {
  CAA_SERVING
  CAA_SERVED
  NOT_YET_SERVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Confidentiality {
  NORMAL
  CONFIDENTIAL
  HIGHLY_CONFIDENTIAL
}

enum MatterStatus {
  OPEN
  ON_HOLD
  CLOSURE_REQUESTED
  CLOSED
}

enum AssignmentRole {
  LEAD
  SUPPORT
}

enum PartyKind {
  OPPOSING
  WITNESS
  INTERNAL
  OTHER
}

/// A piece of legal work (CLAUDE.md: "Matter" — litigation "case" is one matter type).
/// Phase 4 builds creation, listing and assignment; the fields below that only matter to
/// later phases (outcomeId, closingNote, closedAt/By) sit unused until Phase 10's closure
/// workflow so this table doesn't need another migration then.
model Matter {
  id                     String            @id @default(cuid())
  organizationId         String
  organization           Organization      @relation(fields: [organizationId], references: [id])
  reference              String            @unique // generated, e.g. "UCAA/LIT/2026/0042" — never hand-edited
  title                  String
  categoryId             String
  category               Category          @relation(fields: [categoryId], references: [id])
  matterTypeId           String
  matterType             MatterType        @relation(fields: [matterTypeId], references: [id])
  ucaaRole               UcaaRole
  priority               Priority          @default(MEDIUM)
  confidentiality        Confidentiality   @default(NORMAL)
  status                 MatterStatus      @default(OPEN)
  currentStageId         String?
  currentStage           StageTemplate?    @relation(fields: [currentStageId], references: [id])
  forumId                String?
  forum                  Forum?            @relation(fields: [forumId], references: [id])
  courtCaseNo            String?
  eccmisNo               String?
  eccmisUrl              String?
  sourceUrl              String? // link to the published judgment/ruling (e.g. ULII) for lawyers to read in full
  judge                  String?
  amountClaimed          BigInt? // integer UGX (CLAUDE.md) — BigInt, not Int, so a large national claim can't overflow
  amountAgainst          BigInt?
  causeOfActionDate      DateTime?         @db.Date
  referralNote           String?
  // Intake (9-step New case flow): how the matter reached Legal, and its service/court/counsel details.
  description            String?
  reportedAt             DateTime?
  reportedBy             String?
  reportMethod           String?
  serviceDirection       ServiceDirection?
  processNature          String?
  processIssuedAt        DateTime?         @db.Date
  processReceivedAt      DateTime?         @db.Date
  receivedBy             String?
  legalRecipientId       String?
  legalRecipient         User?             @relation("MatterLegalRecipient", fields: [legalRecipientId], references: [id])
  courtStation           String?
  filedAt                DateTime?         @db.Date
  jurisdiction           String?
  representationStatus   String?
  externalCounselName    String?
  externalCounselContact String?
  outcomeId              String?
  outcome                Outcome?          @relation(fields: [outcomeId], references: [id])
  closingNote            String?
  createdById            String
  createdBy              User              @relation("MatterCreatedBy", fields: [createdById], references: [id])
  createdAt              DateTime          @default(now())
  closedAt               DateTime?
  closedById             String?
  closedBy               User?             @relation("MatterClosedBy", fields: [closedById], references: [id])
  lastActivityAt         DateTime          @default(now())
  deletedAt              DateTime? // soft delete by an Admin: hidden everywhere, rows kept for audit
  deletedById            String?

  assignments     MatterAssignment[]
  stageMoves      MatterStage[]
  parties         Party[]
  events          Event[]
  summaryVersions SummaryVersion[]
  notes           Note[]
  documents       Document[]
  calendarEntries CalendarEntry[]
  tasks           Task[]
  notifications   Notification[]
  messages        MatterMessage[]
  chatReads       MatterChatRead[]

  @@index([organizationId])
  @@index([status, priority])
  @@index([categoryId])
  @@index([matterTypeId])
  @@index([forumId])
  @@index([currentStageId])
  @@index([lastActivityAt])
}

/// Contract lifecycle stage (independent of Matter/StageTemplate — spec §5, Contracts
/// register, restructured 2026-10-17 to be fully independent of Legal Matters after a
/// contract was accidentally deleted via the shared matter-delete action). Admin-configurable
/// the same way StageTemplate is for Matters.
model ContractStage {
  id            String  @id @default(cuid())
  name          String  @unique
  description   String?
  order         Int     @default(0)
  allowsClosure Boolean @default(false)
  isActive      Boolean @default(true)

  contractsCurrent Contract[]

  @@index([order])
}

/// A contract the organisation holds, tracked from receipt through legal review, internal
/// approval, Attorney General vetting, amendments and signature to its operational lifecycle.
/// Deliberately NOT a Matter — its own reference series, team, documents and audit trail, so
/// it can never be deleted or modified through the Legal Matters screens.
model Contract {
  id                          String                  @id @default(cuid())
  organizationId              String
  organization                Organization            @relation(fields: [organizationId], references: [id])
  reference                   String                  @unique // e.g. "UCAA/CTR/2026/0001"
  title                       String
  categoryId                  String
  category                    Category                @relation(fields: [categoryId], references: [id])
  counterpartyName            String
  counterpartyContact         String?
  originatingDepartment       String?
  dateOfReceipt               DateTime?               @db.Date
  dateSubmittedForReview      DateTime?               @db.Date
  receiptStatusId             String?
  receiptStatus               ContractStatusOption?   @relation("ContractReceiptStatus", fields: [receiptStatusId], references: [id])
  legalReviewStatusId         String?
  legalReviewStatus           ContractStatusOption?   @relation("ContractLegalReviewStatus", fields: [legalReviewStatusId], references: [id])
  internalApprovalStatusId    String?
  internalApprovalStatus      ContractStatusOption?   @relation("ContractInternalApprovalStatus", fields: [internalApprovalStatusId], references: [id])
  agVettingStatusId           String?
  agVettingStatus             ContractStatusOption?   @relation("ContractAgVettingStatus", fields: [agVettingStatusId], references: [id])
  amendmentsStatusId          String?
  amendmentsStatus            ContractStatusOption?   @relation("ContractAmendmentsStatus", fields: [amendmentsStatusId], references: [id])
  caaExecutionStatus          ContractExecutionStatus @default(PENDING)
  counterpartyExecutionStatus ContractExecutionStatus @default(PENDING)
  dateOfSignature             DateTime?               @db.Date
  dateOfFullExecution         DateTime?               @db.Date
  commencementDate            DateTime?               @db.Date
  expiryDate                  DateTime?               @db.Date
  outstandingAction           String?
  currentStageId              String?
  currentStage                ContractStage?          @relation(fields: [currentStageId], references: [id])
  sourceUrl                   String?
  createdById                 String
  createdBy                   User                    @relation("ContractCreatedBy", fields: [createdById], references: [id])
  createdAt                   DateTime                @default(now())
  lastActivityAt              DateTime                @default(now())
  deletedAt                   DateTime? // soft delete by an Admin: hidden everywhere, rows kept for audit
  deletedById                 String?

  assignments   ContractAssignment[]
  documents     ContractDocument[]
  notifications Notification[]

  @@index([organizationId])
  @@index([categoryId])
  @@index([currentStageId])
  @@index([receiptStatusId])
  @@index([legalReviewStatusId])
  @@index([internalApprovalStatusId])
  @@index([agVettingStatusId])
  @@index([amendmentsStatusId])
  @@index([lastActivityAt])
}

/// Lead/supporting lawyer on a contract — mirrors MatterAssignment.
model ContractAssignment {
  id           String         @id @default(cuid())
  contractId   String
  contract     Contract       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  userId       String
  user         User           @relation("ContractAssignee", fields: [userId], references: [id])
  role         AssignmentRole
  assignedAt   DateTime       @default(now())
  assignedById String
  assignedBy   User           @relation("ContractAssignedBy", fields: [assignedById], references: [id])
  removedAt    DateTime?

  @@index([contractId, removedAt])
  @@index([userId, removedAt])
}

/// A document attached to a contract — mirrors Document/DocumentVersion/DocumentAccessLog
/// (same encrypted-at-rest, virus-scanned, versioned pipeline, spec §9).
model ContractDocument {
  id               String                   @id @default(cuid())
  contractId       String
  contract         Contract                 @relation(fields: [contractId], references: [id], onDelete: Cascade)
  folderId         String
  folder           DocumentFolder           @relation(fields: [folderId], references: [id])
  name             String
  tags             String[]
  confidentiality  Confidentiality          @default(NORMAL)
  currentVersionId String?                  @unique
  currentVersion   ContractDocumentVersion? @relation("ContractCurrentVersion", fields: [currentVersionId], references: [id])
  uploadedById     String
  uploadedBy       User                     @relation(fields: [uploadedById], references: [id])
  createdAt        DateTime                 @default(now())
  deletedAt        DateTime?
  deletedById      String?

  versions   ContractDocumentVersion[]   @relation("ContractDocumentVersions")
  accessLogs ContractDocumentAccessLog[]

  @@index([contractId, deletedAt])
  @@index([folderId])
}

model ContractDocumentVersion {
  id               String           @id @default(cuid())
  documentId       String
  document         ContractDocument @relation("ContractDocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  version          Int
  storageKey       String
  sha256           String
  mimeType         String
  size             Int
  encryptedDataKey String
  iv               String
  authTag          String
  scanStatus       ScanStatus       @default(PENDING)
  scanDetail       String?
  extractedText    String?
  uploadedById     String
  uploadedBy       User             @relation(fields: [uploadedById], references: [id])
  uploadedAt       DateTime         @default(now())

  currentFor ContractDocument? @relation("ContractCurrentVersion")

  @@unique([documentId, version])
}

model ContractDocumentAccessLog {
  id         String           @id @default(cuid())
  documentId String
  document   ContractDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  user       User             @relation(fields: [userId], references: [id])
  action     DocumentAction
  ip         String?
  at         DateTime         @default(now())

  @@index([documentId, at])
  @@index([userId, at])
}

enum ContractExecutionStatus {
  PENDING
  SIGNED
}

/// Admin-configurable dropdown options backing Contract's five status fields
/// (CLAUDE.md: statuses are data, never hard-coded) — one table, grouped by category,
/// editable the same way Outcome/Forum are.
model ContractStatusOption {
  id       String                 @id @default(cuid())
  category ContractStatusCategory
  label    String
  order    Int                    @default(0)
  isActive Boolean                @default(true)

  receiptFor          Contract[] @relation("ContractReceiptStatus")
  legalReviewFor      Contract[] @relation("ContractLegalReviewStatus")
  internalApprovalFor Contract[] @relation("ContractInternalApprovalStatus")
  agVettingFor        Contract[] @relation("ContractAgVettingStatus")
  amendmentsFor       Contract[] @relation("ContractAmendmentsStatus")

  @@unique([category, label])
  @@index([category, order])
}

enum ContractStatusCategory {
  RECEIPT
  LEGAL_REVIEW
  INTERNAL_APPROVAL
  AG_VETTING
  AMENDMENTS
}

/// Lead/supporting lawyer on a matter (CLAUDE.md domain words). Never deleted — removedAt
/// keeps the assignment history intact for the Activity tab (Phase 5).
model MatterAssignment {
  id           String         @id @default(cuid())
  matterId     String
  matter       Matter         @relation(fields: [matterId], references: [id], onDelete: Cascade)
  userId       String
  user         User           @relation("MatterAssignee", fields: [userId], references: [id])
  role         AssignmentRole
  assignedAt   DateTime       @default(now())
  assignedById String
  assignedBy   User           @relation("MatterAssignedBy", fields: [assignedById], references: [id])
  removedAt    DateTime?

  @@index([matterId, removedAt])
  @@index([userId, removedAt])
}

/// One entry in a matter's stage history — current stage is whichever row has no exitedAt.
/// subProcessId isn't here yet since SubProcess (post-judgment applications) is a later phase.
model MatterStage {
  id              String        @id @default(cuid())
  matterId        String
  matter          Matter        @relation(fields: [matterId], references: [id], onDelete: Cascade)
  stageTemplateId String
  stageTemplate   StageTemplate @relation(fields: [stageTemplateId], references: [id])
  enteredAt       DateTime      @default(now())
  exitedAt        DateTime?
  note            String?
  fields          Json? // answers to the stage template's requiredFields, e.g. {"filingDate": "2026-03-01"}
  movedById       String
  movedBy         User          @relation(fields: [movedById], references: [id])

  @@index([matterId, enteredAt])
}

/// Opposing party, witness, or the internal UCAA contact who raised the matter (spec §5.5 step 3).
model Party {
  id           String    @id @default(cuid())
  matterId     String
  matter       Matter    @relation(fields: [matterId], references: [id], onDelete: Cascade)
  name         String
  kind         PartyKind
  counselName  String?
  counselFirm  String?
  email        String?
  phone        String?
  address      String?
  department   String? // INTERNAL kind only — which UCAA department raised the matter
  organisation String?
  partyType    String? // individual / company / government / other
  roleInMatter String? // free-text role, e.g. "Claimant", "Key witness"

  @@index([matterId])
}

/// The New Case wizard's autosaved draft — one per Admin, overwritten as they type (spec §5.5).
model WizardDraft {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Json
  updatedAt DateTime @updatedAt
}

/// One timeline entry (spec §5.7 tab 1) — filings, hearings, rulings, correspondence, stage
/// changes. subProcessId isn't here yet since SubProcess doesn't exist until a later phase.
model Event {
  id          String    @id @default(cuid())
  matterId    String
  matter      Matter    @relation(fields: [matterId], references: [id], onDelete: Cascade)
  date        DateTime
  typeId      String
  type        EventType @relation(fields: [typeId], references: [id])
  title       String
  description String?
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  documentLinks EventDocument[]

  @@index([matterId, date])
}

/// The "Case in 30 seconds" summary (spec §5.7 C) — Matter shows the latest; older ones kept
/// for history. isAiDraft is always false until Phase 14's AI assistant.
model SummaryVersion {
  id        String   @id @default(cuid())
  matterId  String
  matter    Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  body      String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  isAiDraft Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([matterId, createdAt])
}

/// Per-case discussion thread (spec §5.7 tab 5, Phase 9).
model MatterMessage {
  id       String @id @default(cuid())
  matterId String
  matter   Matter @relation(fields: [matterId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation("MatterMessages", fields: [authorId], references: [id])
  body     String

  // Pinning: pinned messages appear on the "Case in 30 seconds" catch-up panel
  isPinned   Boolean   @default(false)
  pinnedAt   DateTime?
  pinnedById String?
  pinnedBy   User?     @relation("MessagePinnedBy", fields: [pinnedById], references: [id])

  // Soft-deletion: legal platforms must never hard-delete messages (CLAUDE.md)
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("MessageDeletedBy", fields: [deletedById], references: [id])

  // Editing: the author may change the text for a short window (FLOWS §10 step 4); the UI shows "edited".
  editedAt DateTime?

  // Reply-in-thread: the message this one answers (SetNull so a reply never blocks anything).
  replyToId String?
  replyTo   MatterMessage?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   MatterMessage[] @relation("MessageReplies")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments MatterMessageAttachment[]
  mentions    MatterMessageMention[]

  @@index([matterId, createdAt])
  @@index([matterId, isPinned])
  @@index([replyToId])
}

/// How far each person has read each case thread — drives unread counts and the "new messages"
/// divider. No row yet means "read up to when you could first see this chat" (see lib/chat/unread.ts).
model MatterChatRead {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  matterId   String
  matter     Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  lastReadAt DateTime

  @@id([userId, matterId])
  @@index([matterId])
}

/// Attachments associated with a case message.
/// Supports dual modes:
/// 1. Direct file upload (encrypted with envelope encryption + scanned via ClamAV)
/// 2. Reference link to an existing Document already filed in the case Documents tab
model MatterMessageAttachment {
  id        String        @id @default(cuid())
  messageId String
  message   MatterMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  // File metadata
  name     String
  size     Int
  mimeType String

  // For directly uploaded chat files (AES-256-GCM envelope encryption)
  storageKey       String?
  sha256           String?
  encryptedDataKey String?
  iv               String?
  authTag          String?
  scanStatus       ScanStatus @default(CLEAN)
  scanDetail       String?

  // For attachments linked from the case's official document repository
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([messageId])
  @@index([documentId])
}

/// Explicit mentions of users within a message (@LawyerName).
model MatterMessageMention {
  id        String        @id @default(cuid())
  messageId String
  message   MatterMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([messageId, userId])
  @@index([userId])
}

/// Shared or private note on a matter (spec §5.7 tab 7). Private notes are visible only to
/// their author and the Admin (FLOWS §6) — enforced in the query, not the schema.
model Note {
  id        String   @id @default(cuid())
  matterId  String
  matter    Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  isPrivate Boolean  @default(false)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([matterId])
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  ERROR
}

enum DocumentAction {
  VIEW
  DOWNLOAD
  PRINT
  SHARE
}

/// A document in a matter's Documents tab (spec §5.7 tab 2, §9). The file bytes never sit in
/// this row — only metadata; content lives in DocumentVersion, encrypted, in private storage.
model Document {
  id               String           @id @default(cuid())
  matterId         String
  matter           Matter           @relation(fields: [matterId], references: [id], onDelete: Cascade)
  folderId         String
  folder           DocumentFolder   @relation(fields: [folderId], references: [id])
  name             String
  tags             String[]
  confidentiality  Confidentiality  @default(NORMAL) // inherits the matter's by default, editable per document
  currentVersionId String?          @unique
  currentVersion   DocumentVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  uploadedById     String
  uploadedBy       User             @relation(fields: [uploadedById], references: [id])
  createdAt        DateTime         @default(now())
  deletedAt        DateTime? // soft delete only (CLAUDE.md) — Admin can restore within the retention period
  deletedById      String?

  versions           DocumentVersion[]         @relation("DocumentVersions")
  accessLogs         DocumentAccessLog[]
  eventLinks         EventDocument[]
  messageAttachments MatterMessageAttachment[]

  @@index([matterId, deletedAt])
  @@index([folderId])
}

/// One uploaded revision of a Document — versions are never overwritten (CLAUDE.md, spec §9).
/// Re-uploading the same file name creates the next version; old ones stay downloadable.
model DocumentVersion {
  id               String     @id @default(cuid())
  documentId       String
  document         Document   @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  version          Int
  storageKey       String // where the encrypted bytes live (local path or object-storage key)
  sha256           String // hash of the plaintext, proves the file wasn't altered
  mimeType         String
  size             Int
  encryptedDataKey String // this version's AES data key, wrapped by the server master key
  iv               String // AES-GCM nonce used to encrypt the file bytes
  authTag          String // AES-GCM auth tag, verifies the ciphertext on decrypt
  scanStatus       ScanStatus @default(PENDING)
  scanDetail       String? // virus name if infected, or why a scan was skipped/failed — never silent
  extractedText    String? // plain text pulled from the file for later search (Phase 11+)
  uploadedById     String
  uploadedBy       User       @relation(fields: [uploadedById], references: [id])
  uploadedAt       DateTime   @default(now())

  currentFor Document? @relation("CurrentVersion")

  @@unique([documentId, version])
}

/// Every view/download/print is logged (spec §9) — visible to Admin, feeds unusual-activity
/// alerts in a later phase.
model DocumentAccessLog {
  id         String         @id @default(cuid())
  documentId String
  document   Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  user       User           @relation(fields: [userId], references: [id])
  action     DocumentAction
  ip         String?
  at         DateTime       @default(now())

  @@index([documentId, at])
  @@index([userId, at])
}

/// Links a document as evidence to a timeline event — blocks deletion without Admin (spec §7).
model EventDocument {
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([eventId, documentId])
}

enum CalendarKind {
  HEARING
  MENTION
  MEDIATION
  JUDGMENT
  DEADLINE
  PERSONAL
}

enum EntryStatus {
  OPEN
  DONE
  NA
}

enum CalendarOutcomeType {
  PROCEEDED
  ADJOURNED
  RULING
  DIRECTIONS
}

/// One dated item on a calendar (spec §5.8) — hearings, deadlines, mediation sessions,
/// judgment dates and personal entries (leave, training). Tasks are NOT duplicated in here;
/// the calendar UI merges CalendarEntry with Task(dueAt) at render time (spec §7 data model).
model CalendarEntry {
  id                  String               @id @default(cuid())
  matterId            String?
  matter              Matter?              @relation(fields: [matterId], references: [id], onDelete: Cascade)
  userId              String? // set for PERSONAL entries only (leave, training) — not tied to a case
  user                User?                @relation("PersonalCalendarEntries", fields: [userId], references: [id])
  kind                CalendarKind
  title               String
  startsAt            DateTime
  endsAt              DateTime?
  forumId             String?
  forum               Forum?               @relation(fields: [forumId], references: [id])
  courtroom           String?
  purpose             String?
  isCritical          Boolean              @default(false)
  assigneeId          String?
  assignee            User?                @relation("AssignedCalendarEntries", fields: [assigneeId], references: [id])
  status              EntryStatus          @default(OPEN)
  naReason            String?
  outcomeType         CalendarOutcomeType?
  outcomeNote         String?
  adjournmentReason   String?
  outcomeRecordedAt   DateTime?
  outcomeRecordedById String?
  outcomeRecordedBy   User?                @relation("OutcomeRecordedEntries", fields: [outcomeRecordedById], references: [id])
  nextEntryId         String?              @unique // set on the OLD entry once an adjournment creates its replacement
  nextEntry           CalendarEntry?       @relation("Adjournment", fields: [nextEntryId], references: [id])
  previousEntry       CalendarEntry?       @relation("Adjournment")
  createdAt           DateTime             @default(now())

  tasksSourced Task[]

  @@index([matterId])
  @@index([assigneeId, startsAt])
  @@index([userId, startsAt])
}

/// A checklist item (spec §5.7 tab 4) — always tied to a matter, unlike a personal calendar entry.
model Task {
  id            String         @id @default(cuid())
  matterId      String
  matter        Matter         @relation(fields: [matterId], references: [id], onDelete: Cascade)
  title         String
  assigneeId    String
  assignee      User           @relation("TasksAssigned", fields: [assigneeId], references: [id])
  dueAt         DateTime
  doneAt        DateTime?
  status        EntryStatus    @default(OPEN)
  naReason      String?
  sourceEntryId String? // set when a hearing outcome's "directions" created this task
  sourceEntry   CalendarEntry? @relation(fields: [sourceEntryId], references: [id])
  createdById   String
  createdBy     User           @relation("TasksCreated", fields: [createdById], references: [id])
  createdAt     DateTime       @default(now())

  @@index([matterId])
  @@index([assigneeId, dueAt])
}

/// Admin-configured: when a timeline event of this type is logged, or a hearing outcome of
/// this kind is recorded, suggest a deadline offsetDays later (spec §5.13, FLOWS §6 & §7).
model DeadlineRule {
  id                 String    @id @default(cuid())
  triggerEventTypeId String
  triggerEventType   EventType @relation(fields: [triggerEventTypeId], references: [id])
  title              String
  offsetDays         Int
  isCritical         Boolean   @default(false)
  isActive           Boolean   @default(true)
}

/// Append-only. The app never updates or deletes rows (enforced with DB privileges in Phase 13).
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
}

/// Org-wide group chat (prototype) — separate from the per-case MatterMessage thread.
/// Everyone in the org can read/post; attachmentUrl/voiceNoteUrl point at an uploaded
/// asset (Phase 6's document storage), no calling backend behind the UI yet.
model GroupMessage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  authorId       String
  author         User         @relation("GroupMessageAuthor", fields: [authorId], references: [id])
  body           String

  // Edit / reply / soft delete work exactly as in a case thread (FLOWS §10). Never hard-deleted.
  editedAt    DateTime?
  replyToId   String?
  replyTo     GroupMessage?  @relation("GroupMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     GroupMessage[] @relation("GroupMessageReplies")
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?          @relation("GroupMessageDeletedBy", fields: [deletedById], references: [id])

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([replyToId])
}

/// How far each person has read the department channel (one channel per organisation).
model GroupChatRead {
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime

  @@id([userId, organizationId])
  @@index([organizationId])
}

/// Directory of outside law firms / counsel the department deals with (spec-adjacent —
/// not tied to a specific matter; a Party's counselFirm is free text and stays that way).
model LawFirm {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  notes       String?
  isActive    Boolean  @default(true)
  addedById   String
  addedBy     User     @relation(fields: [addedById], references: [id])
  createdAt   DateTime @default(now())

  @@index([isActive])
}

/// Quick-reference legal resource links (statutes, court portals, etc.) shown on the
/// Links page — anyone can add one, Admin can remove.
model ResourceLink {
  id        String   @id @default(cuid())
  title     String
  url       String
  category  String?
  addedById String
  addedBy   User     @relation(fields: [addedById], references: [id])
  createdAt DateTime @default(now())

  @@index([category])
}
