// CAA Legal — data model. Grows phase by phase (PROJECT_SPEC.md §7, §12).
// Phase 0: users (profile + security fields), settings, audit log.
// Phase 1: Better Auth's own tables (Session, Account, Verification, TwoFactor) — field
// names/shapes must match what its Prisma adapter expects; see src/lib/auth.ts.
// Phase 2: Admin-configured reference data (spec §5.13) — categories, matter types &
// lifecycle templates, forums, event/document types, outcomes, reminder rules. Nothing
// legal is hard-coded (CLAUDE.md); every later feature reads these instead.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  LAWYER
}

model User {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  emailVerified      Boolean   @default(false)
  image              String?
  phone              String?
  role               Role      @default(LAWYER)
  title              String?
  department         String?
  practisingCertNo   String?
  certExpiry         DateTime? @db.Date
  isActive           Boolean   @default(true)
  // Security state we own (not Better Auth's concern): 2FA display, forced change,
  // lockout. The password hash and TOTP secret live in Account / TwoFactor below.
  twoFactorEnabled   Boolean   @default(false) // field name/shape required by the twoFactor plugin
  mfaEnabledAt       DateTime? // when 2FA setup was completed — for admin visibility only
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime?
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  // Preferences
  digestEnabled      Boolean   @default(false)
  theme              String    @default("system") // system | light | dark
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Set when this account was created by a bulk import; lets a batch be rolled back.
  importBatchId String?
  importBatch   ImportBatch? @relation("BatchMembers", fields: [importBatchId], references: [id])

  auditLogs               AuditLog[]
  settingsUpdated         Setting[]
  sessions                Session[]
  accounts                Account[]
  twoFactor               TwoFactor[]
  importBatchesCreated    ImportBatch[] @relation("BatchCreatedBy")
  importBatchesRolledBack ImportBatch[] @relation("BatchRolledBackBy")

  mattersCreated      Matter[]           @relation("MatterCreatedBy")
  mattersClosed       Matter[]           @relation("MatterClosedBy")
  matterAssignments   MatterAssignment[] @relation("MatterAssignee")
  matterAssignmentsBy MatterAssignment[] @relation("MatterAssignedBy")
  matterStagesMoved   MatterStage[]
  wizardDraft         WizardDraft?

  @@index([role, isActive])
  @@index([importBatchId])
}

/// One bulk-import run (spec §5.12). "details" holds the per-row outcome and error
/// report — no file storage needed for this since Phase 6 doesn't exist yet, and this
/// is small enough (a department's lawyer roster) to keep inline.
model ImportBatch {
  id             String    @id @default(cuid())
  kind           String // "USERS" for now; matters get their own kind in Phase 12
  rowsTotal      Int
  rowsOk         Int
  rowsFailed     Int
  details        Json // { errors: [{ row, reasons }], columns: {...} }
  createdById    String
  createdBy      User      @relation("BatchCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime  @default(now())
  rolledBackAt   DateTime?
  rolledBackById String?
  rolledBackBy   User?     @relation("BatchRolledBackBy", fields: [rolledBackById], references: [id])

  members User[] @relation("BatchMembers")

  @@index([kind, createdAt])
}

// --- Better Auth (email+password, sessions, 2FA). Field shapes are fixed by the
// library's Prisma adapter — see node_modules/@better-auth/core/dist/db/schema/*.
// One session row per signed-in device; deleting all of a user's rows is "sign out everywhere".
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Holds the hashed password (providerId "credential"). No social providers in v1.
model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId            String
  accountId             String
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

/// Single-use tokens: invite links and "forgot password" both use this (spec §15 decision).
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/// TOTP secret + backup codes, added by the twoFactor plugin.
model TwoFactor {
  id                      String    @id @default(cuid())
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret                  String
  backupCodes             String
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  @@index([userId])
}

/// Key/value system settings edited in the Admin Settings portal (security, branding, AI switch…).
model Setting {
  key         String   @id
  value       Json
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
}

enum ClosurePolicy {
  ADMIN_APPROVAL
  LAWYER_CLOSES
}

/// Subject — what a matter is about (spec §7 "Category vs matter type"). Drives reports.
model Category {
  id       String     @id @default(cuid())
  name     String
  parentId String?
  parent   Category?  @relation("CategoryToParent", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToParent")
  color    String // one of the design-token status colours, stored by name (e.g. "primary")
  order    Int        @default(0)
  isActive Boolean    @default(true)

  matters Matter[]

  @@unique([name])
  @@index([parentId])
}

/// Process — how a matter runs; picks its lifecycle (spec §7). isSubProcess marks
/// templates used for applications/appeals/execution/costs inside a matter, not on their own.
model MatterType {
  id              String        @id @default(cuid())
  name            String
  referencePrefix String? // e.g. "LIT" → UCAA/LIT/2026/0042 (spec §5.13); null for sub-process types
  closurePolicy   ClosurePolicy @default(ADMIN_APPROVAL)
  isSubProcess    Boolean       @default(false)
  order           Int           @default(0)
  isActive        Boolean       @default(true)

  stages  StageTemplate[]
  matters Matter[]

  @@unique([name])
  @@index([isSubProcess, isActive])
}

/// One step in a matter type's lifecycle. requiredFields is a small set of field keys the
/// stage-move form must collect (e.g. "filingDate") — the real form fields arrive in Phase 5.
model StageTemplate {
  id             String     @id @default(cuid())
  matterTypeId   String
  matterType     MatterType @relation(fields: [matterTypeId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  order          Int
  allowsClosure  Boolean    @default(false)
  requiredFields String[]
  isActive       Boolean    @default(true)

  mattersCurrent Matter[]
  stageMoves     MatterStage[]

  @@unique([matterTypeId, name])
  @@index([matterTypeId, order])
}

/// Court / tribunal / forum (Uganda hierarchy, spec §3, plus arbitration and internal panels).
model Forum {
  id       String  @id @default(cuid())
  name     String
  level    String // e.g. "HIGH_COURT", "TRIBUNAL", "ARBITRATION", "INTERNAL_PANEL" — a label, not an enum, so Admin can add new kinds
  division String?
  location String?
  order    Int     @default(0)
  isActive Boolean @default(true)

  matters Matter[]

  @@unique([name])
}

/// Timeline event kind (filing, hearing, ruling, correspondence, …).
model EventType {
  id       String  @id @default(cuid())
  name     String  @unique
  icon     String? // lucide-react icon name
  order    Int     @default(0)
  isActive Boolean @default(true)
}

/// Document tab folder (Pleadings, Evidence, Correspondence, Court Orders, Submissions, Internal Memos).
model DocumentFolder {
  id       String  @id @default(cuid())
  name     String  @unique
  order    Int     @default(0)
  isActive Boolean @default(true)
}

/// Matter outcome (Won, Lost, Settled, …).
model Outcome {
  id       String  @id @default(cuid())
  name     String  @unique
  order    Int     @default(0)
  isActive Boolean @default(true)

  matters Matter[]
}

/// Reminder schedule for one trigger (a hearing coming up, a deadline, an assignment, …).
/// Sending the actual reminder is Phase 8; this phase only edits the schedule.
model NotificationRule {
  id       String   @id @default(cuid())
  trigger  String   @unique // e.g. "HEARING_REMINDER", "DEADLINE_REMINDER" — matches spec §5.9
  label    String // shown in the settings UI, e.g. "Hearing coming up"
  offsets  Int[] // days before (positive) / after (negative) the trigger date; 0 = same day
  channels String[] // "IN_APP" | "EMAIL"
  mutable  Boolean  @default(true) // false = lawyer can't turn this one off (spec §5.9)
}

/// Tracks the next case number per prefix+year (used from Phase 4 to generate references).
model ReferenceCounter {
  prefix String
  year   Int
  next   Int    @default(1)

  @@id([prefix, year])
}

enum UcaaRole {
  PLAINTIFF
  DEFENDANT
  APPLICANT
  RESPONDENT
  ADVISOR
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Confidentiality {
  NORMAL
  CONFIDENTIAL
  HIGHLY_CONFIDENTIAL
}

enum MatterStatus {
  OPEN
  ON_HOLD
  CLOSURE_REQUESTED
  CLOSED
}

enum AssignmentRole {
  LEAD
  SUPPORT
}

enum PartyKind {
  OPPOSING
  WITNESS
  INTERNAL
  OTHER
}

/// A piece of legal work (CLAUDE.md: "Matter" — litigation "case" is one matter type).
/// Phase 4 builds creation, listing and assignment; the fields below that only matter to
/// later phases (outcomeId, closingNote, closedAt/By) sit unused until Phase 10's closure
/// workflow so this table doesn't need another migration then.
model Matter {
  id                String          @id @default(cuid())
  reference         String          @unique // generated, e.g. "UCAA/LIT/2026/0042" — never hand-edited
  title             String
  categoryId        String
  category          Category        @relation(fields: [categoryId], references: [id])
  matterTypeId      String
  matterType        MatterType      @relation(fields: [matterTypeId], references: [id])
  ucaaRole          UcaaRole
  priority          Priority        @default(MEDIUM)
  confidentiality   Confidentiality @default(NORMAL)
  status            MatterStatus    @default(OPEN)
  currentStageId    String?
  currentStage      StageTemplate?  @relation(fields: [currentStageId], references: [id])
  forumId           String?
  forum             Forum?          @relation(fields: [forumId], references: [id])
  courtCaseNo       String?
  eccmisNo          String?
  eccmisUrl         String?
  judge             String?
  amountClaimed     BigInt? // integer UGX (CLAUDE.md) — BigInt, not Int, so a large national claim can't overflow
  amountAgainst     BigInt?
  causeOfActionDate DateTime?       @db.Date
  referralNote      String?
  outcomeId         String?
  outcome           Outcome?        @relation(fields: [outcomeId], references: [id])
  closingNote       String?
  createdById       String
  createdBy         User            @relation("MatterCreatedBy", fields: [createdById], references: [id])
  createdAt         DateTime        @default(now())
  closedAt          DateTime?
  closedById        String?
  closedBy          User?           @relation("MatterClosedBy", fields: [closedById], references: [id])
  lastActivityAt    DateTime        @default(now())

  assignments MatterAssignment[]
  stageMoves  MatterStage[]
  parties     Party[]

  @@index([status, priority])
  @@index([categoryId])
  @@index([matterTypeId])
  @@index([forumId])
  @@index([currentStageId])
  @@index([lastActivityAt])
}

/// Lead/supporting lawyer on a matter (CLAUDE.md domain words). Never deleted — removedAt
/// keeps the assignment history intact for the Activity tab (Phase 5).
model MatterAssignment {
  id           String         @id @default(cuid())
  matterId     String
  matter       Matter         @relation(fields: [matterId], references: [id], onDelete: Cascade)
  userId       String
  user         User           @relation("MatterAssignee", fields: [userId], references: [id])
  role         AssignmentRole
  assignedAt   DateTime       @default(now())
  assignedById String
  assignedBy   User           @relation("MatterAssignedBy", fields: [assignedById], references: [id])
  removedAt    DateTime?

  @@index([matterId, removedAt])
  @@index([userId, removedAt])
}

/// One entry in a matter's stage history — current stage is whichever row has no exitedAt.
/// subProcessId isn't here yet since SubProcess (post-judgment applications) is a later phase.
model MatterStage {
  id              String        @id @default(cuid())
  matterId        String
  matter          Matter        @relation(fields: [matterId], references: [id], onDelete: Cascade)
  stageTemplateId String
  stageTemplate   StageTemplate @relation(fields: [stageTemplateId], references: [id])
  enteredAt       DateTime      @default(now())
  exitedAt        DateTime?
  note            String?
  movedById       String
  movedBy         User          @relation(fields: [movedById], references: [id])

  @@index([matterId, enteredAt])
}

/// Opposing party, witness, or the internal UCAA contact who raised the matter (spec §5.5 step 3).
model Party {
  id          String    @id @default(cuid())
  matterId    String
  matter      Matter    @relation(fields: [matterId], references: [id], onDelete: Cascade)
  name        String
  kind        PartyKind
  counselName String?
  counselFirm String?
  email       String?
  phone       String?
  address     String?
  department  String? // INTERNAL kind only — which UCAA department raised the matter

  @@index([matterId])
}

/// The New Case wizard's autosaved draft — one per Admin, overwritten as they type (spec §5.5).
model WizardDraft {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Json
  updatedAt DateTime @updatedAt
}

/// Append-only. The app never updates or deletes rows (enforced with DB privileges in Phase 13).
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
}
