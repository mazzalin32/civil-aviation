// CAA Legal — data model. Grows phase by phase (PROJECT_SPEC.md §7, §12).
// Phase 0: users (profile + security fields), settings, audit log.
// Phase 1: Better Auth's own tables (Session, Account, Verification, TwoFactor) — field
// names/shapes must match what its Prisma adapter expects; see src/lib/auth.ts.
// Phase 2: Admin-configured reference data (spec §5.13) — categories, matter types &
// lifecycle templates, forums, event/document types, outcomes, reminder rules. Nothing
// legal is hard-coded (CLAUDE.md); every later feature reads these instead.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  LAWYER
}

model User {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  emailVerified      Boolean   @default(false)
  image              String?
  phone              String?
  role               Role      @default(LAWYER)
  title              String?
  department         String?
  practisingCertNo   String?
  certExpiry         DateTime? @db.Date
  isActive           Boolean   @default(true)
  // Security state we own (not Better Auth's concern): 2FA display, forced change,
  // lockout. The password hash and TOTP secret live in Account / TwoFactor below.
  twoFactorEnabled   Boolean   @default(false) // field name/shape required by the twoFactor plugin
  mfaEnabledAt       DateTime? // when 2FA setup was completed — for admin visibility only
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime?
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  // Preferences
  digestEnabled      Boolean   @default(false)
  theme              String    @default("system") // system | light | dark
  icsToken           String?   @unique // long-lived token for the .ics calendar subscription URL
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Set when this account was created by a bulk import; lets a batch be rolled back.
  importBatchId String?
  importBatch   ImportBatch? @relation("BatchMembers", fields: [importBatchId], references: [id])

  auditLogs               AuditLog[]
  settingsUpdated         Setting[]
  sessions                Session[]
  accounts                Account[]
  twoFactor               TwoFactor[]
  importBatchesCreated    ImportBatch[] @relation("BatchCreatedBy")
  importBatchesRolledBack ImportBatch[] @relation("BatchRolledBackBy")

  mattersCreated      Matter[]            @relation("MatterCreatedBy")
  mattersClosed       Matter[]            @relation("MatterClosedBy")
  matterAssignments   MatterAssignment[]  @relation("MatterAssignee")
  matterAssignmentsBy MatterAssignment[]  @relation("MatterAssignedBy")
  matterStagesMoved   MatterStage[]
  wizardDraft         WizardDraft?
  eventsCreated       Event[]
  summaryVersions     SummaryVersion[]
  notes               Note[]
  documentsUploaded   Document[]
  documentVersions    DocumentVersion[]
  documentAccessLogs  DocumentAccessLog[]

  personalCalendarEntries CalendarEntry[]          @relation("PersonalCalendarEntries")
  assignedCalendarEntries CalendarEntry[]          @relation("AssignedCalendarEntries")
  outcomesRecorded        CalendarEntry[]          @relation("OutcomeRecordedEntries")
  tasksAssigned           Task[]                   @relation("TasksAssigned")
  tasksCreated            Task[]                   @relation("TasksCreated")
  notifications           Notification[]
  notificationPreferences NotificationPreference[]

  @@index([role, isActive])
  @@index([importBatchId])
}

/// One bulk-import run (spec §5.12). "details" holds the per-row outcome and error
/// report — no file storage needed for this since Phase 6 doesn't exist yet, and this
/// is small enough (a department's lawyer roster) to keep inline.
model ImportBatch {
  id             String    @id @default(cuid())
  kind           String // "USERS" for now; matters get their own kind in Phase 12
  rowsTotal      Int
  rowsOk         Int
  rowsFailed     Int
  details        Json // { errors: [{ row, reasons }], columns: {...} }
  createdById    String
  createdBy      User      @relation("BatchCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime  @default(now())
  rolledBackAt   DateTime?
  rolledBackById String?
  rolledBackBy   User?     @relation("BatchRolledBackBy", fields: [rolledBackById], references: [id])

  members User[] @relation("BatchMembers")

  @@index([kind, createdAt])
}

// --- Better Auth (email+password, sessions, 2FA). Field shapes are fixed by the
// library's Prisma adapter — see node_modules/@better-auth/core/dist/db/schema/*.
// One session row per signed-in device; deleting all of a user's rows is "sign out everywhere".
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Holds the hashed password (providerId "credential"). No social providers in v1.
model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId            String
  accountId             String
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

/// Single-use tokens: invite links and "forgot password" both use this (spec §15 decision).
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/// TOTP secret + backup codes, added by the twoFactor plugin.
model TwoFactor {
  id                      String    @id @default(cuid())
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret                  String
  backupCodes             String
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  @@index([userId])
}

/// Key/value system settings edited in the Admin Settings portal (security, branding, AI switch…).
model Setting {
  key         String   @id
  value       Json
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
}

enum ClosurePolicy {
  ADMIN_APPROVAL
  LAWYER_CLOSES
}

/// Subject — what a matter is about (spec §7 "Category vs matter type"). Drives reports.
model Category {
  id       String     @id @default(cuid())
  name     String
  parentId String?
  parent   Category?  @relation("CategoryToParent", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToParent")
  color    String // one of the design-token status colours, stored by name (e.g. "primary")
  order    Int        @default(0)
  isActive Boolean    @default(true)

  matters Matter[]

  @@unique([name])
  @@index([parentId])
}

/// Process — how a matter runs; picks its lifecycle (spec §7). isSubProcess marks
/// templates used for applications/appeals/execution/costs inside a matter, not on their own.
model MatterType {
  id              String        @id @default(cuid())
  name            String
  referencePrefix String? // e.g. "LIT" → UCAA/LIT/2026/0042 (spec §5.13); null for sub-process types
  closurePolicy   ClosurePolicy @default(ADMIN_APPROVAL)
  isSubProcess    Boolean       @default(false)
  order           Int           @default(0)
  isActive        Boolean       @default(true)

  stages  StageTemplate[]
  matters Matter[]

  @@unique([name])
  @@index([isSubProcess, isActive])
}

/// One step in a matter type's lifecycle. requiredFields is a small set of field keys the
/// stage-move form must collect (e.g. "filingDate") — the real form fields arrive in Phase 5.
model StageTemplate {
  id             String     @id @default(cuid())
  matterTypeId   String
  matterType     MatterType @relation(fields: [matterTypeId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  order          Int
  allowsClosure  Boolean    @default(false)
  requiredFields String[]
  isActive       Boolean    @default(true)

  mattersCurrent Matter[]
  stageMoves     MatterStage[]

  @@unique([matterTypeId, name])
  @@index([matterTypeId, order])
}

/// Court / tribunal / forum (Uganda hierarchy, spec §3, plus arbitration and internal panels).
model Forum {
  id       String  @id @default(cuid())
  name     String
  level    String // e.g. "HIGH_COURT", "TRIBUNAL", "ARBITRATION", "INTERNAL_PANEL" — a label, not an enum, so Admin can add new kinds
  division String?
  location String?
  order    Int     @default(0)
  isActive Boolean @default(true)

  matters         Matter[]
  calendarEntries CalendarEntry[]

  @@unique([name])
}

/// Timeline event kind (filing, hearing, ruling, correspondence, …).
model EventType {
  id       String  @id @default(cuid())
  name     String  @unique
  icon     String? // lucide-react icon name
  order    Int     @default(0)
  isActive Boolean @default(true)

  events        Event[]
  deadlineRules DeadlineRule[]
}

/// Document tab folder (Pleadings, Evidence, Correspondence, Court Orders, Submissions, Internal Memos).
model DocumentFolder {
  id       String  @id @default(cuid())
  name     String  @unique
  order    Int     @default(0)
  isActive Boolean @default(true)

  documents Document[]
}

/// Matter outcome (Won, Lost, Settled, …).
model Outcome {
  id       String  @id @default(cuid())
  name     String  @unique
  order    Int     @default(0)
  isActive Boolean @default(true)

  matters Matter[]
}

/// Reminder schedule for one trigger (a hearing coming up, a deadline, an assignment, …).
/// Sending the actual reminder is Phase 8; this phase only edits the schedule.
model NotificationRule {
  id       String   @id @default(cuid())
  trigger  String   @unique // e.g. "HEARING_REMINDER", "DEADLINE_REMINDER" — matches spec §5.9
  label    String // shown in the settings UI, e.g. "Hearing coming up"
  offsets  Int[] // days before (positive) / after (negative) the trigger date; 0 = same day
  channels String[] // "IN_APP" | "EMAIL"
  mutable  Boolean  @default(true) // false = lawyer can't turn this one off (spec §5.9)

  preferences NotificationPreference[]
}

/// One in-app (+ optionally emailed) notification (spec §5.9, FLOWS §12).
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // matches NotificationRule.trigger
  matterId  String?
  matter    Matter?   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  payload   Json
  readAt    DateTime?
  emailedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/// Per-user mute for a mutable NotificationRule (spec §5.9) — absence of a row means "on"
/// for both channels, so muting is opt-in and a new rule defaults to enabled for everyone.
model NotificationPreference {
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   String
  rule   NotificationRule @relation(fields: [type], references: [trigger], onDelete: Cascade)
  inApp  Boolean          @default(true)
  email  Boolean          @default(true)

  @@id([userId, type])
}

/// Tracks the next case number per prefix+year (used from Phase 4 to generate references).
model ReferenceCounter {
  prefix String
  year   Int
  next   Int    @default(1)

  @@id([prefix, year])
}

enum UcaaRole {
  PLAINTIFF
  DEFENDANT
  APPLICANT
  RESPONDENT
  ADVISOR
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Confidentiality {
  NORMAL
  CONFIDENTIAL
  HIGHLY_CONFIDENTIAL
}

enum MatterStatus {
  OPEN
  ON_HOLD
  CLOSURE_REQUESTED
  CLOSED
}

enum AssignmentRole {
  LEAD
  SUPPORT
}

enum PartyKind {
  OPPOSING
  WITNESS
  INTERNAL
  OTHER
}

/// A piece of legal work (CLAUDE.md: "Matter" — litigation "case" is one matter type).
/// Phase 4 builds creation, listing and assignment; the fields below that only matter to
/// later phases (outcomeId, closingNote, closedAt/By) sit unused until Phase 10's closure
/// workflow so this table doesn't need another migration then.
model Matter {
  id                String          @id @default(cuid())
  reference         String          @unique // generated, e.g. "UCAA/LIT/2026/0042" — never hand-edited
  title             String
  categoryId        String
  category          Category        @relation(fields: [categoryId], references: [id])
  matterTypeId      String
  matterType        MatterType      @relation(fields: [matterTypeId], references: [id])
  ucaaRole          UcaaRole
  priority          Priority        @default(MEDIUM)
  confidentiality   Confidentiality @default(NORMAL)
  status            MatterStatus    @default(OPEN)
  currentStageId    String?
  currentStage      StageTemplate?  @relation(fields: [currentStageId], references: [id])
  forumId           String?
  forum             Forum?          @relation(fields: [forumId], references: [id])
  courtCaseNo       String?
  eccmisNo          String?
  eccmisUrl         String?
  judge             String?
  amountClaimed     BigInt? // integer UGX (CLAUDE.md) — BigInt, not Int, so a large national claim can't overflow
  amountAgainst     BigInt?
  causeOfActionDate DateTime?       @db.Date
  referralNote      String?
  outcomeId         String?
  outcome           Outcome?        @relation(fields: [outcomeId], references: [id])
  closingNote       String?
  createdById       String
  createdBy         User            @relation("MatterCreatedBy", fields: [createdById], references: [id])
  createdAt         DateTime        @default(now())
  closedAt          DateTime?
  closedById        String?
  closedBy          User?           @relation("MatterClosedBy", fields: [closedById], references: [id])
  lastActivityAt    DateTime        @default(now())

  assignments     MatterAssignment[]
  stageMoves      MatterStage[]
  parties         Party[]
  events          Event[]
  summaryVersions SummaryVersion[]
  notes           Note[]
  documents       Document[]
  calendarEntries CalendarEntry[]
  tasks           Task[]
  notifications   Notification[]

  @@index([status, priority])
  @@index([categoryId])
  @@index([matterTypeId])
  @@index([forumId])
  @@index([currentStageId])
  @@index([lastActivityAt])
}

/// Lead/supporting lawyer on a matter (CLAUDE.md domain words). Never deleted — removedAt
/// keeps the assignment history intact for the Activity tab (Phase 5).
model MatterAssignment {
  id           String         @id @default(cuid())
  matterId     String
  matter       Matter         @relation(fields: [matterId], references: [id], onDelete: Cascade)
  userId       String
  user         User           @relation("MatterAssignee", fields: [userId], references: [id])
  role         AssignmentRole
  assignedAt   DateTime       @default(now())
  assignedById String
  assignedBy   User           @relation("MatterAssignedBy", fields: [assignedById], references: [id])
  removedAt    DateTime?

  @@index([matterId, removedAt])
  @@index([userId, removedAt])
}

/// One entry in a matter's stage history — current stage is whichever row has no exitedAt.
/// subProcessId isn't here yet since SubProcess (post-judgment applications) is a later phase.
model MatterStage {
  id              String        @id @default(cuid())
  matterId        String
  matter          Matter        @relation(fields: [matterId], references: [id], onDelete: Cascade)
  stageTemplateId String
  stageTemplate   StageTemplate @relation(fields: [stageTemplateId], references: [id])
  enteredAt       DateTime      @default(now())
  exitedAt        DateTime?
  note            String?
  fields          Json? // answers to the stage template's requiredFields, e.g. {"filingDate": "2026-03-01"}
  movedById       String
  movedBy         User          @relation(fields: [movedById], references: [id])

  @@index([matterId, enteredAt])
}

/// Opposing party, witness, or the internal UCAA contact who raised the matter (spec §5.5 step 3).
model Party {
  id          String    @id @default(cuid())
  matterId    String
  matter      Matter    @relation(fields: [matterId], references: [id], onDelete: Cascade)
  name        String
  kind        PartyKind
  counselName String?
  counselFirm String?
  email       String?
  phone       String?
  address     String?
  department  String? // INTERNAL kind only — which UCAA department raised the matter

  @@index([matterId])
}

/// The New Case wizard's autosaved draft — one per Admin, overwritten as they type (spec §5.5).
model WizardDraft {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Json
  updatedAt DateTime @updatedAt
}

/// One timeline entry (spec §5.7 tab 1) — filings, hearings, rulings, correspondence, stage
/// changes. subProcessId isn't here yet since SubProcess doesn't exist until a later phase.
model Event {
  id          String    @id @default(cuid())
  matterId    String
  matter      Matter    @relation(fields: [matterId], references: [id], onDelete: Cascade)
  date        DateTime
  typeId      String
  type        EventType @relation(fields: [typeId], references: [id])
  title       String
  description String?
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  documentLinks EventDocument[]

  @@index([matterId, date])
}

/// The "Case in 30 seconds" summary (spec §5.7 C) — Matter shows the latest; older ones kept
/// for history. isAiDraft is always false until Phase 14's AI assistant.
model SummaryVersion {
  id        String   @id @default(cuid())
  matterId  String
  matter    Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  body      String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  isAiDraft Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([matterId, createdAt])
}

/// Shared or private note on a matter (spec §5.7 tab 7). Private notes are visible only to
/// their author and the Admin (FLOWS §6) — enforced in the query, not the schema.
model Note {
  id        String   @id @default(cuid())
  matterId  String
  matter    Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  isPrivate Boolean  @default(false)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([matterId])
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  ERROR
}

enum DocumentAction {
  VIEW
  DOWNLOAD
  PRINT
  SHARE
}

/// A document in a matter's Documents tab (spec §5.7 tab 2, §9). The file bytes never sit in
/// this row — only metadata; content lives in DocumentVersion, encrypted, in private storage.
model Document {
  id               String           @id @default(cuid())
  matterId         String
  matter           Matter           @relation(fields: [matterId], references: [id], onDelete: Cascade)
  folderId         String
  folder           DocumentFolder   @relation(fields: [folderId], references: [id])
  name             String
  tags             String[]
  confidentiality  Confidentiality  @default(NORMAL) // inherits the matter's by default, editable per document
  currentVersionId String?          @unique
  currentVersion   DocumentVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  uploadedById     String
  uploadedBy       User             @relation(fields: [uploadedById], references: [id])
  createdAt        DateTime         @default(now())
  deletedAt        DateTime? // soft delete only (CLAUDE.md) — Admin can restore within the retention period
  deletedById      String?

  versions   DocumentVersion[]   @relation("DocumentVersions")
  accessLogs DocumentAccessLog[]
  eventLinks EventDocument[]

  @@index([matterId, deletedAt])
  @@index([folderId])
}

/// One uploaded revision of a Document — versions are never overwritten (CLAUDE.md, spec §9).
/// Re-uploading the same file name creates the next version; old ones stay downloadable.
model DocumentVersion {
  id               String     @id @default(cuid())
  documentId       String
  document         Document   @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  version          Int
  storageKey       String // where the encrypted bytes live (local path or object-storage key)
  sha256           String // hash of the plaintext, proves the file wasn't altered
  mimeType         String
  size             Int
  encryptedDataKey String // this version's AES data key, wrapped by the server master key
  iv               String // AES-GCM nonce used to encrypt the file bytes
  authTag          String // AES-GCM auth tag, verifies the ciphertext on decrypt
  scanStatus       ScanStatus @default(PENDING)
  scanDetail       String? // virus name if infected, or why a scan was skipped/failed — never silent
  extractedText    String? // plain text pulled from the file for later search (Phase 11+)
  uploadedById     String
  uploadedBy       User       @relation(fields: [uploadedById], references: [id])
  uploadedAt       DateTime   @default(now())

  currentFor Document? @relation("CurrentVersion")

  @@unique([documentId, version])
}

/// Every view/download/print is logged (spec §9) — visible to Admin, feeds unusual-activity
/// alerts in a later phase.
model DocumentAccessLog {
  id         String         @id @default(cuid())
  documentId String
  document   Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  user       User           @relation(fields: [userId], references: [id])
  action     DocumentAction
  ip         String?
  at         DateTime       @default(now())

  @@index([documentId, at])
  @@index([userId, at])
}

/// Links a document as evidence to a timeline event — blocks deletion without Admin (spec §7).
model EventDocument {
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([eventId, documentId])
}

enum CalendarKind {
  HEARING
  MENTION
  MEDIATION
  JUDGMENT
  DEADLINE
  PERSONAL
}

enum EntryStatus {
  OPEN
  DONE
  NA
}

enum CalendarOutcomeType {
  PROCEEDED
  ADJOURNED
  RULING
  DIRECTIONS
}

/// One dated item on a calendar (spec §5.8) — hearings, deadlines, mediation sessions,
/// judgment dates and personal entries (leave, training). Tasks are NOT duplicated in here;
/// the calendar UI merges CalendarEntry with Task(dueAt) at render time (spec §7 data model).
model CalendarEntry {
  id                  String               @id @default(cuid())
  matterId            String?
  matter              Matter?              @relation(fields: [matterId], references: [id], onDelete: Cascade)
  userId              String? // set for PERSONAL entries only (leave, training) — not tied to a case
  user                User?                @relation("PersonalCalendarEntries", fields: [userId], references: [id])
  kind                CalendarKind
  title               String
  startsAt            DateTime
  endsAt              DateTime?
  forumId             String?
  forum               Forum?               @relation(fields: [forumId], references: [id])
  courtroom           String?
  purpose             String?
  isCritical          Boolean              @default(false)
  assigneeId          String?
  assignee            User?                @relation("AssignedCalendarEntries", fields: [assigneeId], references: [id])
  status              EntryStatus          @default(OPEN)
  naReason            String?
  outcomeType         CalendarOutcomeType?
  outcomeNote         String?
  adjournmentReason   String?
  outcomeRecordedAt   DateTime?
  outcomeRecordedById String?
  outcomeRecordedBy   User?                @relation("OutcomeRecordedEntries", fields: [outcomeRecordedById], references: [id])
  nextEntryId         String?              @unique // set on the OLD entry once an adjournment creates its replacement
  nextEntry           CalendarEntry?       @relation("Adjournment", fields: [nextEntryId], references: [id])
  previousEntry       CalendarEntry?       @relation("Adjournment")
  createdAt           DateTime             @default(now())

  tasksSourced Task[]

  @@index([matterId])
  @@index([assigneeId, startsAt])
  @@index([userId, startsAt])
}

/// A checklist item (spec §5.7 tab 4) — always tied to a matter, unlike a personal calendar entry.
model Task {
  id            String         @id @default(cuid())
  matterId      String
  matter        Matter         @relation(fields: [matterId], references: [id], onDelete: Cascade)
  title         String
  assigneeId    String
  assignee      User           @relation("TasksAssigned", fields: [assigneeId], references: [id])
  dueAt         DateTime
  doneAt        DateTime?
  status        EntryStatus    @default(OPEN)
  naReason      String?
  sourceEntryId String? // set when a hearing outcome's "directions" created this task
  sourceEntry   CalendarEntry? @relation(fields: [sourceEntryId], references: [id])
  createdById   String
  createdBy     User           @relation("TasksCreated", fields: [createdById], references: [id])
  createdAt     DateTime       @default(now())

  @@index([matterId])
  @@index([assigneeId, dueAt])
}

/// Admin-configured: when a timeline event of this type is logged, or a hearing outcome of
/// this kind is recorded, suggest a deadline offsetDays later (spec §5.13, FLOWS §6 & §7).
model DeadlineRule {
  id                 String    @id @default(cuid())
  triggerEventTypeId String
  triggerEventType   EventType @relation(fields: [triggerEventTypeId], references: [id])
  title              String
  offsetDays         Int
  isCritical         Boolean   @default(false)
  isActive           Boolean   @default(true)
}

/// Append-only. The app never updates or deletes rows (enforced with DB privileges in Phase 13).
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
}
